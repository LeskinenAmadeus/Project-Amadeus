{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amadeus",
  "version": "0.6.0-alpha.1",
  "identifier": "com.projectamadeus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Project Amadeus",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],"resources": [
  "resources/Modelfile"
    ],
    "publisher": "John Paredes",
    "copyright": "Copyright © 2026 John Paredes",
    "shortDescription": "Local AI desktop companion with Live2D integration.",
    "longDescription": "Project Amadeus is a local AI desktop companion powered by Ollama, featuring streamed conversations, persistent local chat history, application settings, Live2D character animation, expressions, motions, and local system readiness checks.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}